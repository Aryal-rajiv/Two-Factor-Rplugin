<?xml version="1.0"?>
<ruleset name="Lightweight Email 2FA">
	<file>.</file>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<arg name="extensions" value="php"/>
	<config name="minimum_wp_version" value="5.8"/>
	<config name="testVersion" value="7.4-"/>
	<rule ref="WordPress"/>
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array"><element value="lightweight-email-2fa"/></property>
		</properties>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array"><element value="lwe2fa"/></property>
		</properties>
	</rule>
</ruleset>
